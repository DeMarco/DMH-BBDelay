			)
		)
		(uuid "340fd2bd-c6c1-42b2-b22f-48053234e4ac")
	)
	(text_box "Idea in case phaser mode doesn't sound good due to the 5kHz filtering:\n\nUse extra CD4053 per channel to bypass the Input and Output filters.\nThe 3rd switch in the CD4053 can be used to add a resistor to -12V to add the 2.5V offset needed for the V3205.\nCommand the CD4053 with a 3-way DPDT, combining the range cap selection."
		(exclude_from_sim no)
		(at 12.7 114.3 0)
		(size 52.07 25.4)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
